# Auto detect text files and normalize line endings
* text=auto

# Source code
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cc text eol=lf

# Shaders
*.hlsl text eol=lf
*.hlsli text eol=lf
*.fx text eol=lf
*.fxh text eol=lf

# Config
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Visual Studio
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.dds binary
*.hdr binary
*.tga binary
*.wav binary
*.ogg binary
*.mp3 binary
*.dll binary
*.lib binary
*.exe binary
*.pdb binary
*.cso binary
*.zip binary
